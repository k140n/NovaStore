# ==============================================================================
# NovaStore Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production, set these variables in your hosting provider's dashboard (e.g. Render, Railway, Heroku).
# ==============================================================================

# Core Django Security
# Generate a cryptographically secure key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-novastore-local-dev-key-replace-in-production-2026
DEBUG=True

# Hostname / Domain Configuration (comma-separated)
# In production, set to your actual domain, e.g. "novastore.onrender.com,novastore.com"
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Trusted Origins for CSRF Protection (comma-separated with scheme)
# Required in Django 4.0+ for cross-domain POST requests in production
CSRF_TRUSTED_ORIGINS=https://novastore.onrender.com,http://127.0.0.1:8080

# Database Configuration
# Local SQLite default (leave unset or use sqlite:///db.sqlite3):
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL example:
# DATABASE_URL=postgresql://novastore_user:securepassword@localhost:5432/novastore_db

# Production SSL & Strict Transport Security (Active when DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

