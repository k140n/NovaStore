# NovaStore Environment Variables Configuration
# Copy this file to .env for local development

# Security
SECRET_KEY=django-insecure-novastore-local-dev-key-replace-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database (Leave unset or sqlite for local development; use postgresql://... in production)
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/novastore_db
